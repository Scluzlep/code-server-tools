# ==============================================================================
# code-server-withtools 全局版本控制与基础配置
# ==============================================================================

# GHCR 镜像仓库与版本控制配置
REGISTRY_OWNER=scluzlep
TOOLCHAIN_IMAGE_NAME=dev-toolchain-base
RUNNER_IMAGE_NAME=code-server-withtools

# dev-toolchain-base 版本号 (每次变更工具链递增，构建时以此作为镜像 Tag 并归档 .env)
TOOLCHAIN_VERSION=1.0.0

# 默认上游 code-server 基础版本号 (CI 每日检测到新 Release 时自动继承对应版本号)
CODE_SERVER_VERSION=4.137.0

# ------------------------------------------------------------------------------
# Java / JVM 环境配置
# ------------------------------------------------------------------------------
JAVA_DEFAULT_VERSION=21
JAVA_VERSIONS="8 17 21 25"
GRADLE_VERSION=9.7.1
JDK25_URL=https://api.adoptium.net/v3/binary/latest/25/ga/linux/aarch64/jdk/hotspot/normal/eclipse

# ------------------------------------------------------------------------------
# Python 环境配置 (Astral uv 管理)
# ------------------------------------------------------------------------------
PYTHON_DEFAULT_VERSION=312
PYTHON_VERSIONS="310 312 313 314"
PYTHON_VERSION_310=3.10.21
PYTHON_VERSION_312=3.12.14
PYTHON_VERSION_313=3.13.15
PYTHON_VERSION_314=3.14.7

# ------------------------------------------------------------------------------
# Golang 环境配置 (严格按指定要求保留 1.26.8 和 1.27.1，默认 1.26.8)
# ------------------------------------------------------------------------------
GO_DEFAULT_VERSION=1.26.8
GO_VERSIONS="1.26.8 1.27.1"
GO_VERSION_1=1.26.8
GO_VERSION_2=1.27.1

# ------------------------------------------------------------------------------
# Android SDK & 逆向工具链 (最新稳定版本)
# ------------------------------------------------------------------------------
ANDROID_CMDLINE_TOOLS_VERSION=11076708
ANDROID_PLATFORM=android-36
ANDROID_BUILD_TOOLS=36.0.0
KOTLIN_VERSION=2.4.20
JADX_VERSION=1.5.6
APKTOOL_VERSION=3.0.3

# ------------------------------------------------------------------------------
# Node.js 前端环境 (最新 LTS 版本)
# ------------------------------------------------------------------------------
NODE_VERSION=24.21.0

# ------------------------------------------------------------------------------
# Flutter SDK
# ------------------------------------------------------------------------------
FLUTTER_CHANNEL=stable
