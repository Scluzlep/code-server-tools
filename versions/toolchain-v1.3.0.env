# ==============================================================================
# code-server-withtools 全局版本控制与基础配置
# ==============================================================================

# GHCR 镜像仓库与版本控制配置
TOOLCHAIN_IMAGE_NAME=dev-toolchain-base
RUNNER_IMAGE_NAME=code-server-withtools

# dev-toolchain-base 版本号 (每次变更工具链递增，构建时以此作为镜像 Tag 并归档 .env)
TOOLCHAIN_VERSION=1.3.0

# 默认上游 code-server 与运行层 CLI 基础版本号 (CI 每日检测到新 Release 时自动继承对应版本号)
CODE_SERVER_VERSION=4.146.0
TTYD_VERSION=1.7.7
GH_VERSION=2.105.0
YQ_VERSION=4.54.3

# ------------------------------------------------------------------------------
# Java / JVM 环境配置
# ------------------------------------------------------------------------------
JAVA_DEFAULT_VERSION=21
JAVA_VERSIONS="8 17 21 25"
GRADLE_VERSION=9.9.2
JDK25_URL=https://api.adoptium.net/v3/binary/latest/25/ga/linux/{ARCH}/jdk/hotspot/normal/eclipse

# ------------------------------------------------------------------------------
# Python 环境配置 (Astral uv 管理)
# ------------------------------------------------------------------------------
PYTHON_DEFAULT_VERSION=312
PYTHON_VERSIONS="310 312 313 314 315"
PYTHON_VERSION_310=3.10.22
PYTHON_VERSION_312=3.12.16
PYTHON_VERSION_313=3.13.18
PYTHON_VERSION_314=3.14.10
PYTHON_VERSION_315=3.15.2

# ------------------------------------------------------------------------------
# Golang 环境配置 (双版本支持 1.26.11 和 1.27.4，默认 1.26.11)
# ------------------------------------------------------------------------------
GO_DEFAULT_VERSION=1.26.11
GO_VERSIONS="1.26.11 1.27.4"
GO_VERSION_1=1.26.11
GO_VERSION_2=1.27.4

# ------------------------------------------------------------------------------
# Android SDK & 逆向工具链 (最新稳定版本)
# ------------------------------------------------------------------------------
ANDROID_CMDLINE_TOOLS_VERSION=15641748
ANDROID_PLATFORM=android-37.2
ANDROID_BUILD_TOOLS=37.0.0
KOTLIN_VERSION=2.4.21
JADX_VERSION=1.5.7
APKTOOL_VERSION=3.0.3

# ------------------------------------------------------------------------------
# Node.js 前端环境 (最新 LTS 版本)
# ------------------------------------------------------------------------------
NODE_VERSION=26.13.1

# ------------------------------------------------------------------------------
# Flutter SDK
# ------------------------------------------------------------------------------
FLUTTER_CHANNEL=stable
